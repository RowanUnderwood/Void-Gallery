// Windows resources for ImageTunnel.scr. String 1 is the name Windows shows in the screensaver list.
#include <windows.h>

STRINGTABLE
BEGIN
    1 "Image Tunnel"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Image Tunnel screensaver"
            VALUE "ProductName", "Image Tunnel"
            VALUE "FileVersion", "1.0.0"
            VALUE "OriginalFilename", "ImageTunnel.scr"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
